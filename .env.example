# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# GitHub OAuth Configuration (Frontend)
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id
VITE_GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
VITE_GITHUB_REDIRECT_URI=http://localhost:3000/oauth-callback

# GitHub App Configuration (Backend)
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
PORT=3001

# Worker Configuration
WORKER_TOKEN=secure-worker-token-for-authentication

# Claude API Configuration
CLAUDE_API_KEY=your_claude_api_key

# Development
NODE_ENV=development